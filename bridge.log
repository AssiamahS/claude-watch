#!/bin/sh
# resume.html + resume-infra.html -> dist/ docx + pdf, plus a canonical
# ATS-friendly upload name (Sylvester-Assiamah-Resume.pdf, built from the
# PM master; scipio renames whichever variant it uploads to the same
# canonical name at apply time).
set -e
cd "$(dirname "$0")"
mkdir -p dist

# markdown is the source of truth; html is generated
python3 render.py resume.md resume.html
python3 render.py resume-infra.md resume-infra.html

textutil -convert docx resume.html -output "dist/Resume - Sylvester Assiamah (Project Manager).docx"
textutil -convert docx resume-infra.html -output "dist/Resume - Sylvester Assiamah (Infrastructure Engineer).docx"

# pdf via playwright chromium (shared install in ~/Library/Caches/ms-playwright)
python3 - <<'PY'
import asyncio, pathlib, sys
try:
    from playwright.async_api import async_playwright
except ImportError:
    sys.exit("playwright not on this python — run via: cd ../scipio/auto-apply && uv run ../../soeasy/build.sh")

BUILDS = [
    ("resume.html", "dist/Resume - Sylvester Assiamah (Project Manager).pdf"),
    ("resume-infra.html", "dist/Resume - Sylvester Assiamah (Infrastructure Engineer).pdf"),
]

async def main():
    async with async_playwright() as p:
        b = await p.chromium.launch()
        page = await b.new_page()
        for src_name, out_name in BUILDS:
            src = pathlib.Path(src_name).resolve()
            out = pathlib.Path(out_name).resolve()
            await page.goto(f"file://{src}")
            await page.pdf(path=str(out), format="Letter",
                           margin={"top": "0.4in", "bottom": "0.35in", "left": "0.5in", "right": "0.5in"})
        await b.close()

asyncio.run(main())
PY

cp "dist/Resume - Sylvester Assiamah (Project Manager).pdf" "dist/Sylvester-Assiamah-Resume.pdf"

echo "built:"
ls -la dist/

# keep scipio's tailor engine in sync with the bank + renderer
cp bank.json ../scipio/auto-apply/bank.json
cp render.py ../scipio/auto-apply/render_resume.py
