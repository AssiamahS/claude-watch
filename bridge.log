        if bridge.isPaired {
            Task {
                let reachable = await verifyBridge()
                await MainActor.run {
                    if reachable {
                        isPaired = true
                        startEventStream()
                    } else {
                        bridge.unpair()
                        isPaired = false
                    }
                }
            }
        }
    }

