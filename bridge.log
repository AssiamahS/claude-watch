#!/usr/bin/env python3
"""
fl-midi MCP server — sends MIDI to FL Studio (or any DAW) via a virtual
CoreMIDI port on macOS. No IAC Driver configuration required.

The virtual output port "Claude FL MIDI" is opened lazily on the first MIDI
tool call — NOT at startup. Every Claude session spawns this server, and an
always-on port announces a new MIDI device to every running audio app
(Serato hung mid-set enumerating five of them). Don't move the open back to
import time.
In FL Studio: Options → MIDI Settings → enable "Claude FL MIDI" as input,
assign a port number, turn on Omni. Then route a channel to an instrument.
"""
import asyncio
import time
import threading
from typing import List

import rtmidi
from mcp.server.fastmcp import FastMCP

PORT_NAME = "Claude FL MIDI"

# Lock so overlapping sequence calls don't interleave note streams mid-message.
_send_lock = threading.Lock()

midi_out = None


