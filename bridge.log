name: auto-apply

on:
  workflow_dispatch:
    inputs:
      mode:
        description: what to run
        type: choice
        default: batch
        options:
          - batch
          - score
      url:
        description: job url (score mode only)
        required: false
      limit:
        description: max jobs in batch mode
        default: "3"
      dry_run:
        description: fill but don't submit
        type: boolean
        default: false
  schedule:
    # weekdays 13:00 UTC / 9am ET — score + dry-run fill the wishlist
    - cron: "0 13 * * 1-5"

permissions:
  contents: write
  models: read
  actions: write
