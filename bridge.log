/Users/djsly/sepratealexa/bin/nofime: Paul Falstad's zsh script text executable, Unicode text, UTF-8 text
#!/bin/zsh
# Push a notification to the Echo Show via the Notify Me skill.
#   nofime "message"            one-off
#   echo "msg" | nofime         from a pipe
# Setup (one time): enable "Notify Me" skill in the Alexa app, say
# "Alexa, open Notify Me", paste the emailed access code into ~/.nofime_code
set -e

CODE_FILE="$HOME/.nofime_code"
[ -r "$CODE_FILE" ] || { echo "nofime: missing $CODE_FILE — enable the Notify Me skill, say 'Alexa, open Notify Me', save the emailed code there" >&2; exit 1; }
CODE=$(tr -d '[:space:]' < "$CODE_FILE")

MSG="${1:-$(cat)}"
[ -n "$MSG" ] || { echo "nofime: empty message" >&2; exit 1; }

HTTP=$(curl -sS -o /tmp/nofime-resp.txt -w '%{http_code}' \
  -X POST https://api.notifymyecho.com/v1/NotifyMe \
  -H 'Content-Type: application/json' \
  --data "$(python3 -c "import json,sys; print(json.dumps({'notification': sys.argv[1], 'accessCode': sys.argv[2]}))" "$MSG" "$CODE")")

if [ "${HTTP:0:1}" = "2" ]; then
  echo "sent: $MSG"
else
  echo "nofime: HTTP $HTTP — $(cat /tmp/nofime-resp.txt)" >&2
  exit 1
fi
