function hash(s: string) {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
  return Math.abs(h);
}

/** Destination-city hero for a flight card; falls back to a jet. */
export function destinationImage(iata: string | undefined, seed = "") {
  if (iata && CITY_IMAGES[iata]) return CITY_IMAGES[iata];
  return JET_POOL[hash(seed || iata || "x") % JET_POOL.length];
}

/** Aircraft photo: use operator-uploaded image when present, else a category placeholder. */
export function aircraftImage(
  aircraft: { images?: string[]; category?: string } | undefined,
  seed = "",
) {
  const first = aircraft?.images?.find((i) => /^https?:\/\/images\.unsplash\.com\//.test(i));
  if (first) return first;
  if (aircraft?.category && CATEGORY_IMAGES[aircraft.category]) return CATEGORY_IMAGES[aircraft.category];
  return JET_POOL[hash(seed) % JET_POOL.length];
}

export function categoryImage(category: string) {
  return CATEGORY_IMAGES[category] ?? IMAGES.jetA;
}
import "server-only";
import { ApiError, asList, type Paginated } from "./api";

export interface ListResult<T> {
  items: T[];
  error: string | null;
}

/** Load a list endpoint and turn failures into a display message instead of a crash. */
export async function loadList<T>(promise: Promise<T[] | Paginated<T>>): Promise<ListResult<T>> {
  try {
    return { items: asList(await promise), error: null };
  } catch (err) {
    if (err instanceof ApiError) {
      if (err.status === 403) return { items: [], error: "Your role does not have access to this data." };
      if (err.status === 401) return { items: [], error: "Your session has expired. Please sign in again." };
      return { items: [], error: `API error ${err.status}: ${err.message}` };
    }
    return { items: [], error: "The marketplace API is not reachable." };
  }
}
import "server-only";
import { api, ApiError, safeApi, type Booking, type Flight } from "./api";

export type BookingLoad = { booking: Booking; flight: Flight } | null | "down";

/** GET /bookings/:id, then fill in the flight if the API did not embed it. */
export async function loadBookingWithFlight(id: string, token: string): Promise<BookingLoad> {
  let booking: Booking;
  try {
    booking = await api.booking(id, token);
  } catch (err) {
    if (err instanceof ApiError && (err.status === 404 || err.status === 403)) return null;
    return "down";
  }
  const flight = booking.flight ?? (await safeApi(api.flight(booking.flightId), null));
  if (!flight) return "down";
  return { booking, flight };
}
import { NextResponse, type NextRequest } from "next/server";
import { API_URL, TOKEN_COOKIE, isAdminRole, isOperatorRole, type Role } from "@/lib/api";

function signInRedirect(req: NextRequest) {
  const url = req.nextUrl.clone();
  url.pathname = "/sign-in";
  url.search = `?next=${encodeURIComponent(req.nextUrl.pathname + req.nextUrl.search)}`;
  return NextResponse.redirect(url);
}

function deniedRedirect(req: NextRequest) {
  const url = req.nextUrl.clone();
  url.pathname = "/";
  url.search = "?denied=1";
  return NextResponse.redirect(url);
}

export async function middleware(req: NextRequest) {
  const token = req.cookies.get(TOKEN_COOKIE)?.value;
  if (!token) return signInRedirect(req);

  const { pathname } = req.nextUrl;
  let role: Role | null = null;
  try {
    const res = await fetch(`${API_URL}/me`, {
      headers: { Authorization: `Bearer ${token}`, Accept: "application/json" },
      cache: "no-store",
    });
    if (res.status === 401 || res.status === 403) {
      const redirect = signInRedirect(req);
      redirect.cookies.delete(TOKEN_COOKIE);
      return redirect;
    }
    if (res.ok) {
      const user = (await res.json()) as { role?: Role };
      role = user.role ?? null;
    }
  } catch {
    // API unreachable: let the page render; server layouts enforce again.
    return NextResponse.next();
  }

  if (role) {
    if (pathname.startsWith("/operator") && !isOperatorRole(role)) return deniedRedirect(req);
    if (pathname.startsWith("/admin") && !isAdminRole(role)) return deniedRedirect(req);
    if (pathname.startsWith("/book") && role !== "CUSTOMER" && !isAdminRole(role)) {
      return deniedRedirect(req);
    }
  }
  return NextResponse.next();
}

export const config = {
  matcher: ["/operator/:path*", "/admin/:path*", "/book/:path*", "/bookings/:path*"],
};
