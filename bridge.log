def build_tailored(jd_text: str, role_title: str, out_pdf: str):
    """Returns manifest dict, or None if tailoring isn't possible."""
    if not BANK.exists() or len(jd_text or "") < 300:
        return None
    bank = json.loads(BANK.read_text())
    jd = tokens(jd_text)
    summary = pick_summary(bank, role_title or "", jd)
    chosen, manifest = pick_bullets(bank, jd)
    if not summary or not chosen:
        return None

    md = to_markdown(bank, summary, chosen)
    out = Path(out_pdf)
    out.parent.mkdir(parents=True, exist_ok=True)
    md_path = out.with_suffix(".md")
    html_path = out.with_suffix(".html")
    md_path.write_text(md)

    _render_via_cli(md_path, html_path)  # soeasy's renderer, synced by build.sh

    from playwright.sync_api import sync_playwright
    with sync_playwright() as p:
        b = p.chromium.launch()
        page = b.new_page()
        page.goto(f"file://{html_path.resolve()}")
        page.pdf(path=str(out), format="Letter",
                 margin={"top": "0.4in", "bottom": "0.35in", "left": "0.5in", "right": "0.5in"})
        b.close()
    return {"pdf": str(out), "summary_used": summary[:60], "choices": manifest}


def _render_via_cli(md_path, html_path):
    import subprocess
    subprocess.run([sys.executable, str(HERE / "render_resume.py"),
                    str(md_path), str(html_path)], check=True)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--jd-file", required=True)
    ap.add_argument("--role", default="")
    ap.add_argument("--out", default="resumes_tailored/test.pdf")
    a = ap.parse_args()
    m = build_tailored(Path(a.jd_file).read_text(), a.role, a.out)
    print(json.dumps(m, indent=1) if m else "tailoring not possible")


if __name__ == "__main__":
    main()
