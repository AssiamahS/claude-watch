/**
 * Typed client for the Last Leg Jet API (docs/ARCHITECTURE.md contract).
 *
 * - On the server, call `apiFetch(path, { token })` – hits the API directly.
 * - In the browser, call `clientApi(path)` – goes through the Next proxy
 *   route (`/api/proxy/*`) which attaches the httpOnly `llj_token` cookie as
 *   a Bearer header.
 */

export const API_URL = process.env.NEXT_PUBLIC_API_URL ?? "http://localhost:4000/v1";
export const TOKEN_COOKIE = "llj_token";

// ---------------------------------------------------------------------------
// Enums (mirror apps/api/prisma/schema.prisma)
// ---------------------------------------------------------------------------

export type Role =
  | "CUSTOMER"
  | "OPERATOR_ADMIN"
  | "OPERATOR_STAFF"
  | "PLATFORM_ADMIN"
  | "COMPLIANCE_ADMIN"
  | "FINANCE_ADMIN"
  | "SUPPORT";

export type VerificationStatus = "PENDING" | "UNDER_REVIEW" | "VERIFIED" | "REJECTED" | "SUSPENDED";
export type AircraftCategory = "LIGHT_JET" | "MIDSIZE" | "SUPER_MIDSIZE" | "HEAVY_JET" | "TURBOPROP";
export type FlightStatus = "DRAFT" | "PUBLISHED" | "SOLD_OUT" | "CANCELLED" | "COMPLETED";
