    private static func parse(path: String, mtime: Date, statuses: [String: String]) -> Session? {
        guard let handle = FileHandle(forReadingAtPath: path) else { return nil }
        defer { try? handle.close() }
        let size = (try? handle.seekToEnd()) ?? 0
        let offset = size > UInt64(tailBytes) ? size - UInt64(tailBytes) : 0
        try? handle.seek(toOffset: offset)
        guard let data = try? handle.readToEnd(),
              let text = String(data: data, encoding: .utf8) else { return nil }

        var lastUser = ""
        var lastAssistant = ""
        var cwd = ""
        var sessionId = ""
        var title = ""

        // Walk forward keeping the latest of each; a partial first line (we
        // seeked into the middle of it) just fails JSON parsing and is skipped.
        for line in text.split(separator: "\n") {
            guard let obj = try? JSONSerialization.jsonObject(with: Data(line.utf8)) as? [String: Any],
                  let type = obj["type"] as? String else { continue }
            if obj["isSidechain"] as? Bool == true { continue }
            if cwd.isEmpty, let c = obj["cwd"] as? String { cwd = c }
            if sessionId.isEmpty, let s = obj["sessionId"] as? String { sessionId = s }
            if type == "ai-title", let t = obj["aiTitle"] as? String, !t.isEmpty { title = t }
            guard let message = obj["message"] as? [String: Any] else { continue }

            switch type {
            case "user":
                if let t = userText(message), !t.isEmpty { lastUser = t }
            case "assistant":
                if let t = assistantText(message), !t.isEmpty { lastAssistant = t }
            default:
                break
            }
        }

        guard !lastUser.isEmpty || !lastAssistant.isEmpty else { return nil }
        if sessionId.isEmpty {
            sessionId = (path as NSString).lastPathComponent.replacingOccurrences(of: ".jsonl", with: "")
        }
        let project = cwd.isEmpty ? "unknown" : ((cwd as NSString).lastPathComponent)
        let status = statuses[sessionId]
        return Session(
            id: sessionId,
            project: project == "djsly" ? "~" : project,
            cwd: cwd,
            lastUser: clip(lastUser),
            lastAssistant: clip(lastAssistant),
            updatedAt: mtime,
            active: status == "busy" || Date().timeIntervalSince(mtime) < 120,
            title: title.isEmpty ? nil : title,
            status: status
        )
    }

    /// Real typed prompts only — tool results arrive as user turns with
    /// array content, and command/system chatter starts with "<".
    private static func userText(_ message: [String: Any]) -> String? {
        guard let content = message["content"] as? String else { return nil }
        let trimmed = content.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !trimmed.isEmpty, !trimmed.hasPrefix("<") else { return nil }
        return trimmed
    }

    private static func assistantText(_ message: [String: Any]) -> String? {
