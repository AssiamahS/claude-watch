{
  "manifest_version": 3,
  "name": "Scipio Auto-Apply",
  "version": "1.9.5",
  "description": "Auto-fill job applications with your profile. Works on any site.",
  "permissions": ["activeTab", "storage", "scripting", "clipboardRead", "clipboardWrite", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://www.google.com/recaptcha/*", "*://www.recaptcha.net/*"],
      "js": ["captcha.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
