#!/usr/bin/env python3
"""Follow-up DRAFTS for confirmed applications going quiet.

For every distinct submitted application 5-10 days old with no rejection and
no interview invite, write a short plain-voice follow-up into the Gmail
Drafts folder (IMAP APPEND). NOTHING IS EVER AUTO-SENT — Sylvester reviews
and sends from his phone. One draft per application, ever (state file).

Voice rules: short, no em dashes, no AI-sounding phrasing.

  uv run python followups.py [--dry-run]
Env: GMAIL_APP_PASSWORD, GMAIL_IMAP_USER (same as rejections.py)
"""
import imaplib
import json
import os
import re
import sys
import time
from datetime import datetime, timedelta
from email.message import EmailMessage
from pathlib import Path

HERE = Path(__file__).parent
STATE = HERE / "followups_state.json"

DRAFT_BODY = """Hi,

I applied for the {role} position about a week ago and wanted to check in. \
I'm still very interested. My background running infrastructure and IT projects \
at Hackensack Meridian Health lines up well with what the posting describes, \
and I'd welcome the chance to talk about it.

Happy to send anything else that would help.

Best,
Sylvester Assiamah
908-839-0555
"""


def load(name, default):
    try:
        return json.loads((HERE / name).read_text())
    except Exception:
        return default


def norm(s):
    return re.sub(r"[^a-z0-9]", "", (s or "").lower())


def main():
    dry = "--dry-run" in sys.argv
    log = load("apply_log.json", [])
    rejections = load("rejections.json", [])
    invites = load("needs_reply.json", [])
    state = load("followups_state.json", {"drafted": []})
    drafted = set(state["drafted"])

    rej = {norm(r.get("company", "")) for r in rejections}
    inv = {norm(r.get("company", "")) for r in invites}

    now = datetime.now()
    todo = []
    seen_urls = set()
    for e in log:
        det = e.get("details", {})
        status = (det.get("status") or e.get("status") or "").lower()
        url = (e.get("url") or det.get("url") or "").split("?")[0]
        if "submit" not in status or not url or url in seen_urls or url in drafted:
            continue
        seen_urls.add(url)
        try:
            sent_at = datetime.fromisoformat(e.get("timestamp", "")[:19])
        except ValueError:
            continue
        age = now - sent_at
        if not (timedelta(days=5) <= age <= timedelta(days=10)):
            continue
        c = norm(e.get("company", ""))
        if c and (any(c in r or r in c for r in rej if r) or
                  any(c in r or r in c for r in inv if r)):
            continue
        todo.append((url, e))

    if not todo:
        print("no follow-ups due")
        return

    user = os.environ.get("GMAIL_IMAP_USER", "")
    pw = os.environ.get("GMAIL_APP_PASSWORD", "")
    box = None
    if not dry and user and pw:
        box = imaplib.IMAP4_SSL("imap.gmail.com")
        box.login(user, pw)

    for url, e in todo[:5]:   # cap per run
        company = e.get("company") or "the team"
        role = e.get("role") or "the role"
        msg = EmailMessage()
        msg["Subject"] = f"Following up on my {role} application"
        msg["From"] = user
        msg["To"] = ""   # recruiter address filled in by hand before sending
        msg.set_content(DRAFT_BODY.format(role=role) + f"\n[{company} — {url}]\n")
        print(f"  draft: {company} — {role}")
        if box:
            box.append("[Gmail]/Drafts", "\\Draft",
                       imaplib.Time2Internaldate(time.time()),
                       msg.as_bytes())
        drafted.add(url)

    if box:
        box.logout()
    if not dry:
        STATE.write_text(json.dumps({"drafted": sorted(drafted)}, indent=0))
    print(f"{min(len(todo),5)} draft(s) written to Gmail Drafts")


if __name__ == "__main__":
    main()
