  "MIDSIZE",
  "SUPER_MIDSIZE",
  "HEAVY_JET",
  "TURBOPROP",
];
export const FLIGHT_STATUSES: FlightStatus[] = ["DRAFT", "PUBLISHED", "SOLD_OUT", "CANCELLED", "COMPLETED"];

export const OPERATOR_ROLES: Role[] = ["OPERATOR_ADMIN", "OPERATOR_STAFF"];
export const ADMIN_ROLES: Role[] = ["PLATFORM_ADMIN", "COMPLIANCE_ADMIN", "FINANCE_ADMIN", "SUPPORT"];

export function isOperatorRole(role?: Role | null) {
  return !!role && OPERATOR_ROLES.includes(role);
}
export function isAdminRole(role?: Role | null) {
  return !!role && ADMIN_ROLES.includes(role);
}

